{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Origin++",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.origin",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.origin",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.origin",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.origin",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.origin",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.origin",
                    "match": "\\b(jak|inakjak|inak|cykl|takt|return|break|continue|import|print|nic)\\b"
                },
                {
                    "name": "keyword.other.origin",
                    "match": "\\b(baza)\\b"
                },
                {
                    "name": "keyword.operator.logical.origin",
                    "match": "\\b(abo|ta)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.numeric.float.origin",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.origin",
                    "match": "\\b[0-9]+\\b"
                },
                {
                    "name": "constant.language.boolean.origin",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.origin",
                    "match": "\\b(int|double|float|char|bool|string|list|void)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.origin",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(::)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "variable.other.object.origin"
                        },
                        "2": {
                            "name": "keyword.operator.namespace.origin"
                        },
                        "3": {
                            "name": "variable.other.member.origin"
                        }
                    }
                }
            ]
        }
    },
    "scopeName": "source.origin"
}
